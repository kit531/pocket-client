+import android.webkit.WebViewClient
+import kotlinx.coroutines.CompletableDeferred
+import kotlin.coroutines.cancellation.CancellationException
+
+/**
+ * Pocket Client: Microsoft sign-in the same way Pocket Client 1 did it, which worked for this account:
+ * login.live.com authorization-code flow with the public Minecraft launcher client ID, shown in a plain
+ * WebView. The device-code flow kept ending in "invalid_grant" for some accounts.
+ */
+object PocketLogin {
+    const val CLIENT_ID = "00000000402b5328"
+    const val SCOPE = "service::user.auth.xboxlive.com::MBI_SSL"
+    const val REDIRECT_URL = "https://login.live.com/oauth20_desktop.srf"
+    const val AUTHORIZE_URL = "https://login.live.com/oauth20_authorize.srf" +
+            "?client_id=$CLIENT_ID" +
+            "&response_type=code" +
+            "&scope=service%3A%3Auser.auth.xboxlive.com%3A%3AMBI_SSL" +
+            "&redirect_url=https%3A%2F%2Flogin.live.com%2Foauth20_desktop.srf"
+
+    /** Where login.live.com sends the browser after sign-in, carrying ?code=... */
+    const val RESULT_PREFIX = "ms-xal-$CLIENT_ID"
+
+    @Volatile
+    private var pending: CompletableDeferred<String?>? = null
+
+    /** Opens the sign-in page and waits for the authorization code. Throws CancellationException if the user backs out. */
+    suspend fun requestCode(context: Context): String {
+        val deferred = CompletableDeferred<String?>()
+        pending?.complete(null)
+        pending = deferred
+        context.startActivity(
+            Intent(context, PocketLoginActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        )
+        return deferred.await() ?: throw CancellationException("Microsoft sign-in was cancelled")
+    }
+
+    internal fun deliver(code: String?) {
+        pending?.complete(code)
+        pending = null
+    }
+}
+
+class PocketLoginActivity : Activity() {
+    private var delivered = false
+
+    @SuppressLint("SetJavaScriptEnabled")
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val web = WebView(this)
+        web.setBackgroundColor(Color.WHITE)
+        setContentView(web)
+
+        web.settings.javaScriptEnabled = true
+        web.settings.domStorageEnabled = true
+        web.webViewClient = object : WebViewClient() {
+            override fun shouldOverrideUrlLoading(view: WebView, request: WebResourceRequest): Boolean =
+                handle(request.url.toString())
+
+            override fun onPageStarted(view: WebView, url: String, favicon: Bitmap?) {
+                if (!handle(url)) super.onPageStarted(view, url, favicon)
+            }
+        }
+
+        //A fresh session every time, like Pocket Client 1
+        CookieManager.getInstance().removeAllCookies {
+            web.clearHistory()
+            web.clearCache(true)
+            web.clearFormData()
+            web.loadUrl(PocketLogin.AUTHORIZE_URL)
+        }
+    }
+
+    private fun handle(url: String): Boolean {
+        if (url.startsWith(PocketLogin.RESULT_PREFIX)) {
+            finishWith(Uri.parse(url).getQueryParameter("code"))
+            return true
+        }
+        if (url.contains("res=cancel")) {
+            finishWith(null)
+            return true
+        }
+        return false
+    }
+
+    private fun finishWith(code: String?) {
+        if (delivered) return
+        delivered = true
+        PocketLogin.deliver(code)
+        finish()
+    }
+
+    override fun onDestroy() {
+        if (!delivered) {
+            delivered = true
+            PocketLogin.deliver(null)
+        }
+        super.onDestroy()
+    }
+}
diff --git a/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/pocket/PocketTuning.kt b/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/pocket/PocketTuning.kt
