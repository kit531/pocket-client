@@ -0,0 +1,217 @@
+package com.movtery.zalithlauncher.pocket
+
+import android.content.Intent
+import android.util.Log
+import android.widget.Toast
+import androidx.appcompat.app.AlertDialog
+import androidx.appcompat.app.AppCompatActivity
+import androidx.core.content.FileProvider
+import androidx.lifecycle.lifecycleScope
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import com.movtery.zalithlauncher.BuildConfig
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import org.json.JSONObject
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import java.net.HttpURLConnection
+import java.net.URL
+import java.security.MessageDigest
+import java.util.Locale
+
+/**
+ * Pocket Client: self-update from GitHub Releases with small downloads.
+ *
+ * CI publishes pc_update.json on the "v2-update" release. It lists the newest build and a bsdiff patch from
+ * the previous build. When the installed version has a patch, only the patch is downloaded and the new APK
+ * is rebuilt locally from the installed one ([BsPatch]); the result is checked against the full APK's
+ * SHA-256 before Android is asked to install it. Without a matching patch, the full APK is downloaded.
+ */
+object PocketUpdater {
+    private const val TAG = "PocketUpdater"
+    private const val INFO_URL = "https://github.com/kit531/pocket-client/releases/download/v2-update/pc_update.json"
+
+    class Patch(val from: Int, val url: String, val size: Long, val sha256: String)
+    class Info(
+        val code: Int, val name: String, val notes: String,
+        val apkUrl: String, val apkSize: Long, val apkSha256: String,
+        val patches: List<Patch>
+    )
+
+    private var checkedThisRun = false
+
+    /** Checks for an update. [manual] shows "up to date"/error toasts; automatic checks run once per app start. */
+    @JvmStatic
+    fun check(activity: AppCompatActivity, manual: Boolean) {
+        if (!manual) {
+            if (checkedThisRun) return
+            checkedThisRun = true
+        }
+        activity.lifecycleScope.launch {
+            val info = withContext(Dispatchers.IO) {
+                runCatching { parse(httpGetText(INFO_URL)) }
+                    .onFailure { Log.w(TAG, "Update check failed", it) }
+                    .getOrNull()
+            }
+            if (info == null) {
+                if (manual) toast(activity, "Could not check for updates")
+                return@launch
+            }
+            val current = BuildConfig.VERSION_CODE
+            if (info.code <= current) {
+                if (manual) toast(activity, "Pocket Client is up to date")
+                return@launch
+            }
+            val patch = info.patches.firstOrNull { it.from == current }
+            val size = patch?.size ?: info.apkSize
+            val sizeText = String.format(Locale.ROOT, "%.1f MB", size / 1048576.0)
+            val how = if (patch != null) "Download: $sizeText (only what changed)" else "Download: $sizeText (full app)"
+            MaterialAlertDialogBuilder(activity)
+                .setTitle("Update: Pocket Client ${info.name}")
+                .setMessage(info.notes.trim() + "\n\n" + how)
+                .setPositiveButton("Update") { _, _ -> download(activity, info, patch) }
+                .setNegativeButton("Later", null)
+                .show()
+        }
+    }
+
+    private fun download(activity: AppCompatActivity, info: Info, patch: Patch?) {
+        val progress: AlertDialog = MaterialAlertDialogBuilder(activity)
+            .setTitle("Updating Pocket Client")
+            .setMessage("Starting…")
+            .setCancelable(false)
+            .create()
+        progress.show()
+        fun status(text: String) = activity.runOnUiThread { progress.setMessage(text) }
+
+        activity.lifecycleScope.launch {
+            val result = withContext(Dispatchers.IO) {
+                runCatching {
+                    val dir = File(activity.cacheDir, "pc_update").apply { deleteRecursively(); mkdirs() }
+                    val apk = File(dir, "update.apk")
+                    var ready = false
+
+                    if (patch != null) {
+                        ready = runCatching {
+                            val patchFile = File(dir, "update.patch")
+                            downloadTo(patch.url, patchFile) { done -> status("Downloading changes… ${percent(done, patch.size)}") }
+                            if (!sha256(patchFile).equals(patch.sha256, ignoreCase = true)) throw IOException("Patch checksum mismatch")
+                            status("Applying update…")
+                            BsPatch.apply(File(activity.applicationInfo.sourceDir), patchFile, apk)
+                            patchFile.delete()
+                            status("Verifying…")
+                            sha256(apk).equals(info.apkSha256, ignoreCase = true)
+                        }.onFailure { Log.w(TAG, "Patch update failed, falling back to the full APK", it) }
+                            .getOrDefault(false)
+                    }
+
+                    if (!ready) {
+                        downloadTo(info.apkUrl, apk) { done -> status("Downloading… ${percent(done, info.apkSize)}") }
+                        status("Verifying…")
+                        if (!sha256(apk).equals(info.apkSha256, ignoreCase = true)) throw IOException("Download checksum mismatch")
+                    }
+                    apk
+                }
+            }
+            progress.dismiss()
+            result.onSuccess { install(activity, it) }
+                .onFailure {
+                    Log.e(TAG, "Update failed", it)
+                    MaterialAlertDialogBuilder(activity)
+                        .setTitle("Update failed")
+                        .setMessage(it.message ?: it.javaClass.simpleName)
+                        .setPositiveButton(android.R.string.ok, null)
+                        .show()
+                }
+        }
+    }
+
+    private fun install(activity: AppCompatActivity, apk: File) {
+        val uri = FileProvider.getUriForFile(activity, activity.packageName + ".provider", apk)
+        val intent = Intent(Intent.ACTION_VIEW)
+            .setDataAndType(uri, "application/vnd.android.package-archive")
+            .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION or Intent.FLAG_ACTIVITY_NEW_TASK)
+        activity.startActivity(intent)
+    }
+
+    private fun parse(json: String): Info {
+        val o = JSONObject(json)
+        val patches = ArrayList<Patch>()
+        o.optJSONArray("patches")?.let { arr ->
+            for (i in 0 until arr.length()) {
+                val p = arr.getJSONObject(i)
+                patches.add(Patch(p.getInt("from"), p.getString("url"), p.getLong("size"), p.getString("sha256")))
+            }
+        }
+        return Info(
+            o.getInt("code"), o.getString("name"), o.optString("notes"),
+            o.getString("apk_url"), o.getLong("apk_size"), o.getString("apk_sha256"),
+            patches
+        )
+    }
+
+    private fun open(url: String): HttpURLConnection {
+        val conn = URL(url).openConnection() as HttpURLConnection
+        conn.instanceFollowRedirects = true
+        conn.connectTimeout = 15000
+        conn.readTimeout = 30000
+        conn.setRequestProperty("User-Agent", "PocketClient/${BuildConfig.VERSION_NAME}")
+        if (conn.responseCode !in 200..299) throw IOException("HTTP ${conn.responseCode} for $url")
+        return conn
+    }
+
+    private fun httpGetText(url: String): String {
+        val conn = open(url)
+        try {
+            return conn.inputStream.bufferedReader().use { it.readText() }
+        } finally {
+            conn.disconnect()
+        }
+    }
+
+    private fun downloadTo(url: String, out: File, onProgress: (Long) -> Unit) {
+        val conn = open(url)
+        try {
+            conn.inputStream.use { input ->
+                FileOutputStream(out).use { output ->
+                    val buf = ByteArray(1 shl 16)
+                    var done = 0L
+                    var lastReport = 0L
+                    while (true) {
+                        val n = input.read(buf)
+                        if (n < 0) break
+                        output.write(buf, 0, n)
+                        done += n
+                        if (done - lastReport > 512 * 1024) {
+                            lastReport = done
+                            onProgress(done)
+                        }
+                    }
+                }
+            }
+        } finally {
+            conn.disconnect()
+        }
+    }
+
+    private fun percent(done: Long, total: Long): String =
+        if (total > 0) "${(done * 100 / total).coerceIn(0, 100)}%" else String.format(Locale.ROOT, "%.1f MB", done / 1048576.0)
+
+    private fun sha256(file: File): String {
+        val md = MessageDigest.getInstance("SHA-256")
+        file.inputStream().use { input ->
+            val buf = ByteArray(1 shl 16)
+            while (true) {
+                val n = input.read(buf)
+                if (n < 0) break
+                md.update(buf, 0, n)
+            }
+        }
+        return md.digest().joinToString("") { "%02x".format(it) }
+    }
+
+    private fun toast(activity: AppCompatActivity, text: String) =
+        Toast.makeText(activity, text, Toast.LENGTH_SHORT).show()
+}
