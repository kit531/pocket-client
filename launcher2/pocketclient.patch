index 0000000..3a00ffd
--- /dev/null
+++ b/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/pocket/PocketTuning.kt
@@ -0,0 +1,104 @@
+package com.movtery.zalithlauncher.pocket
+
+import android.app.ActivityManager
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import android.os.Process
+import android.util.Log
+import java.io.File
+
+/**
+ * Pocket Client: battery and smoothness defaults for phones.
+ */
+object PocketTuning {
+    private const val TAG = "PocketTuning"
+    private const val MARKER = ".pocketclient-tuned"
+
+    fun totalRamMb(context: Context): Long {
+        val am = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
+        val info = ActivityManager.MemoryInfo()
+        am.getMemoryInfo(info)
+        return info.totalMem / (1024 * 1024)
+    }
+
+    /** Java heap when the player never set one. Upstream would fall back to the 256 MB minimum. */
+    fun defaultRamMb(context: Context): Int {
+        val total = totalRamMb(context)
+        return when {
+            total >= 7168 -> 3072
+            total >= 5120 -> 2048
+            total >= 3584 -> 1536
+            else -> 1024
+        }
+    }
+
+    /**
+     * G1 tuned for short pauses: most stutter (and wasted CPU, i.e. battery) in modded play comes from long
+     * collections. Skipped when the player set their own GC flags.
+     */
+    fun addGcArgs(args: MutableList<String>) {
+        if (args.any { (it.startsWith("-XX:+Use") && it.endsWith("GC")) || it.startsWith("-XX:MaxGCPauseMillis") || it.startsWith("-XX:G1") }) return
+        args.add("-XX:+UseG1GC")
+        args.add("-XX:+UnlockExperimentalVMOptions")
+        args.add("-XX:MaxGCPauseMillis=40")
+        args.add("-XX:G1NewSizePercent=20")
+        args.add("-XX:G1ReservePercent=20")
+        args.add("-XX:+ParallelRefProcEnabled")
+        args.add("-XX:+DisableExplicitGC")
+    }
+
+    /**
+     * Once per game directory: distances, FPS cap and cheap visual options that fit the phone.
+     * 60 FPS instead of uncapped roughly halves GPU work. Anything the player changes later is kept.
+     */
+    fun tuneOptions(context: Context, gameDir: File) {
+        try {
+            val marker = File(gameDir, MARKER)
+            if (marker.exists()) return
+            val ram = totalRamMb(context)
+            val tier = when {
+                ram < 4096 -> listOf("renderDistance" to "4", "simulationDistance" to "4", "maxFps" to "40", "particles" to "2")
+                ram < 8192 -> listOf("renderDistance" to "6", "simulationDistance" to "5", "maxFps" to "60", "particles" to "1")
+                else -> listOf("renderDistance" to "8", "simulationDistance" to "6", "maxFps" to "60", "particles" to "1")
+            }
+            val cheap = listOf(
+                "enableVsync" to "false",
+                "graphicsMode" to "0",
+                "renderClouds" to "\"false\"",
+                "entityShadows" to "false",
+                "biomeBlendRadius" to "0",
+                "mipmapLevels" to "0",
+                "entityDistanceScaling" to "0.75"
+            )
+
+            val file = File(gameDir, "options.txt")
+            val options = LinkedHashMap<String, String>()
+            if (file.isFile) {
+                file.readLines().forEach { line ->
+                    val i = line.indexOf(':')
+                    if (i > 0) options[line.substring(0, i)] = line.substring(i + 1)
+                }
+            }
+            (tier + cheap).forEach { (k, v) -> options[k] = v }
+            gameDir.mkdirs()
+            file.writeText(options.entries.joinToString("\n") { "${it.key}:${it.value}" } + "\n")
+            marker.createNewFile()
+            Log.i(TAG, "Tuned options for $ram MB RAM: $tier")
+        } catch (e: Exception) {
+            Log.w(TAG, "Could not tune options", e)
+        }
+    }
+
+    /**
+     * The game runs in its own process (":game"). Once it has started, the launcher's process is not needed:
+     * end it so none of its threads, services or UI keep using CPU and memory while playing.
+     * When the game exits, the launcher is restarted (upstream already does this).
+     */
+    fun endLauncherProcessSoon() {
+        Handler(Looper.getMainLooper()).postDelayed({
+            Log.i(TAG, "Game started, ending the launcher process")
+            Process.killProcess(Process.myPid())
+        }, 3000)
+    }
+}
diff --git a/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/pocket/PocketUpdater.kt b/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/pocket/PocketUpdater.kt
