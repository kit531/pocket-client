+/**
+ * Pocket Client: the simple home screen. Portrait stacks the skin above the account and version cards;
+ * landscape puts the skin on one side and the cards on the other, so both fill the screen evenly.
+ */
+@Composable
+private fun PocketHome(
+    isPortrait: Boolean,
+    isVisible: Boolean,
+    onLaunchGame: (Version?) -> Unit,
+    toAccountManageScreen: () -> Unit,
+    toChangeSkin: () -> Unit,
+    toVersionManageScreen: () -> Unit,
+    toVersionSettingsScreen: () -> Unit,
+) {
+    val account by AccountsManager.currentAccountFlow.collectAsStateWithLifecycle()
+    val yOffset by swapAnimateDpAsState(
+        targetValue = 40.dp,
+        swapIn = isVisible
+    )
+
+    val cards: @Composable (Modifier) -> Unit = { modifier ->
+        Column(
+            modifier = modifier,
+            verticalArrangement = Arrangement.spacedBy(12.dp, Alignment.CenterVertically)
+        ) {
+            BackgroundCard(
+                modifier = Modifier.fillMaxWidth(),
+                shape = MaterialTheme.shapes.extraLarge,
+                onClick = toAccountManageScreen
+            ) {
+                AccountAvatarRow(
+                    modifier = Modifier.fillMaxWidth(),
+                    account = account,
+                )
+            }
+            BackgroundCard(
+                modifier = Modifier.fillMaxWidth(),
+                shape = MaterialTheme.shapes.extraLarge,
+            ) {
+                VersionsContent(
+                    modifier = Modifier.fillMaxWidth(),
+                    onLaunchGame = onLaunchGame,
+                    toVersionManageScreen = toVersionManageScreen,
+                    toVersionSettingsScreen = toVersionSettingsScreen,
+                )
+            }
+        }
+    }
+
+    val contentModifier = Modifier
+        .fillMaxSize()
+        .offset { IntOffset(x = 0, y = yOffset.roundToPx()) }
+        .padding(16.dp)
+
+    if (isPortrait) {
+        Column(
+            modifier = contentModifier,
+            verticalArrangement = Arrangement.spacedBy(12.dp)
+        ) {
+            PocketSkin(
+                modifier = Modifier
+                    .weight(1f)
+                    .fillMaxWidth(),
+                account = account,
+                onChangeSkin = toChangeSkin
+            )
+            cards(Modifier.fillMaxWidth())
+        }
+    } else {
+        Row(
+            modifier = contentModifier,
+            horizontalArrangement = Arrangement.spacedBy(16.dp)
+        ) {
+            PocketSkin(
+                modifier = Modifier
+                    .weight(1f)
+                    .fillMaxHeight(),
+                account = account,
+                onChangeSkin = toChangeSkin
+            )
+            cards(
+                Modifier
+                    .weight(1f)
+                    .fillMaxHeight()
+            )
+        }
+    }
+}
+
+@Composable
+private fun PocketSkin(
+    modifier: Modifier = Modifier,
+    account: Account?,
+    onChangeSkin: () -> Unit,
+) {
+    val refreshWardrobe by AccountsManager.refreshWardrobe.collectAsStateWithLifecycle()
+    val skinStamp = account?.getSkinFile()?.lastModified()
+    val capeStamp = account?.getCapeFile()?.lastModified()
+    val skinBytes by produceState<ByteArray?>(null, account, refreshWardrobe, skinStamp) {
+        value = account?.getSkinFile()?.takeIf { it.exists() }
+            ?.inputStream()?.use { it.readBytes() }
+    }
+    val capeBytes by produceState<ByteArray?>(null, account, refreshWardrobe, capeStamp) {
+        value = account?.getCapeFile()?.takeIf { it.exists() }
+            ?.inputStream()?.use { it.readBytes() }
+    }
+    //the arm model is read from the skin picture when the account does not know it (offline accounts
+    //and imported skins), so slim (Alex) and wide (Steve) skins both show correctly
+    val armModel by produceState<ArmModel?>(null, account, refreshWardrobe, skinStamp) {
+        value = account?.skinModelType?.toArmModel()
+            ?: account?.getSkinFile()?.takeIf { it.exists() }?.let { file ->
+                if (file.isSlimModel()) ArmModel.Slim else ArmModel.Classic
+            }
+    }
+
+    Column(
+        modifier = modifier,
+        horizontalAlignment = Alignment.CenterHorizontally,
+        verticalArrangement = Arrangement.spacedBy(8.dp)
+    ) {
+        //keyed on the picture, so the model is rebuilt when the skin or the arm type changes
+        key(skinBytes?.contentHashCode(), armModel) {
+            PetModelView(
+                modifier = Modifier
+                    .weight(1f)
+                    .fillMaxWidth(),
+                skin = skinBytes,
+                cape = capeBytes,
+                arm = armModel,
+                animation = PetAnimation.Idle,
+                tapReaction = PetTapReaction.Interact,
+                dragYaw = true
+            )
+        }
+        FilledTonalButton(onClick = onChangeSkin) {
+            Text(stringResource(R.string.pocket_change_skin))
+        }
+    }
+}
