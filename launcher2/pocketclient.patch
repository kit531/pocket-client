+package com.movtery.zalithlauncher.pocket
+
+import org.apache.commons.compress.compressors.bzip2.BZip2CompressorInputStream
+import java.io.BufferedInputStream
+import java.io.BufferedOutputStream
+import java.io.EOFException
+import java.io.File
+import java.io.FileInputStream
+import java.io.FileOutputStream
+import java.io.IOException
+import java.io.InputStream
+import java.io.RandomAccessFile
+
+/**
+ * Pocket Client: streaming bspatch (BSDIFF40 format, as written by the standard `bsdiff` tool).
+ * Rebuilds the new APK from the installed one plus a small patch, without loading either into memory.
+ */
+object BsPatch {
+    private const val BUF = 1 shl 16
+
+    @Throws(IOException::class)
+    fun apply(oldFile: File, patchFile: File, newFile: File) {
+        val header = ByteArray(32)
+        RandomAccessFile(patchFile, "r").use { it.readFully(header) }
+        if (String(header, 0, 8, Charsets.US_ASCII) != "BSDIFF40") throw IOException("Not a bsdiff patch")
+        val ctrlLen = offtin(header, 8)
+        val diffLen = offtin(header, 16)
+        val newSize = offtin(header, 24)
+        if (ctrlLen < 0 || diffLen < 0 || newSize < 0) throw IOException("Corrupt patch header")
+
+        openSection(patchFile, 32).use { ctrl ->
+            openSection(patchFile, 32 + ctrlLen).use { diff ->
+                openSection(patchFile, 32 + ctrlLen + diffLen).use { extra ->
+                    RandomAccessFile(oldFile, "r").use { old ->
+                        BufferedOutputStream(FileOutputStream(newFile), BUF).use { out ->
+                            patch(ctrl, diff, extra, old, out, newSize)
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    private fun patch(
+        ctrl: InputStream, diff: InputStream, extra: InputStream,
+        old: RandomAccessFile, out: BufferedOutputStream, newSize: Long
+    ) {
+        val oldSize = old.length()
+        val buf = ByteArray(BUF)
+        val oldBuf = ByteArray(BUF)
+        val num = ByteArray(8)
+        var newPos = 0L
+        var oldPos = 0L
+
+        while (newPos < newSize) {
+            readFully(ctrl, num, 8); val x = offtin(num, 0)
+            readFully(ctrl, num, 8); val y = offtin(num, 0)
+            readFully(ctrl, num, 8); val z = offtin(num, 0)
+            if (x < 0 || y < 0 || newPos + x > newSize) throw IOException("Corrupt patch")
+
+            var remaining = x
+            while (remaining > 0) {
+                val n = minOf(remaining, BUF.toLong()).toInt()
+                readFully(diff, buf, n)
+                readOld(old, oldSize, oldPos, oldBuf, n)
+                for (i in 0 until n) buf[i] = (buf[i] + oldBuf[i]).toByte()
+                out.write(buf, 0, n)
+                oldPos += n
+                newPos += n
+                remaining -= n
+            }
+
+            if (newPos + y > newSize) throw IOException("Corrupt patch")
+            remaining = y
+            while (remaining > 0) {
+                val n = minOf(remaining, BUF.toLong()).toInt()
+                readFully(extra, buf, n)
+                out.write(buf, 0, n)
+                newPos += n
+                remaining -= n
+            }
+            oldPos += z
+        }
+    }
+
+    /** Old bytes for [pos, pos + n); positions outside the old file count as zero, like bspatch. */
+    private fun readOld(old: RandomAccessFile, oldSize: Long, pos: Long, dst: ByteArray, n: Int) {
+        java.util.Arrays.fill(dst, 0, n, 0)
+        val start = maxOf(pos, 0L)
+        val end = minOf(pos + n, oldSize)
+        if (start < end) {
+            old.seek(start)
+            old.readFully(dst, (start - pos).toInt(), (end - start).toInt())
+        }
+    }
+
+    private fun openSection(file: File, offset: Long): InputStream {
+        val fis = FileInputStream(file)
+        fis.channel.position(offset)
+        return BZip2CompressorInputStream(BufferedInputStream(fis, BUF))
+    }
+
+    private fun readFully(input: InputStream, dst: ByteArray, n: Int) {
+        var off = 0
+        while (off < n) {
+            val r = input.read(dst, off, n - off)
+            if (r < 0) throw EOFException("Unexpected end of patch")
+            off += r
+        }
+    }
+
+    /** bsdiff's sign-magnitude little-endian 64-bit integer. */
+    private fun offtin(b: ByteArray, off: Int): Long {
+        var y = (b[off + 7].toLong() and 0x7F)
+        for (i in 6 downTo 0) y = (y shl 8) or (b[off + i].toLong() and 0xFF)
+        return if ((b[off + 7].toInt() and 0x80) != 0) -y else y
+    }
+}
diff --git a/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/pocket/PocketBatteryLog.kt b/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/pocket/PocketBatteryLog.kt
new file mode 100644
index 0000000..022c9ae
--- /dev/null
+++ b/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/pocket/PocketBatteryLog.kt
@@ -0,0 +1,211 @@
+package com.movtery.zalithlauncher.pocket
+
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.os.BatteryManager
+import android.os.Build
+import android.os.Handler
+import android.os.HandlerThread
+import android.os.PowerManager
+import android.util.Log
+import com.movtery.zalithlauncher.BuildConfig
+import com.movtery.zalithlauncher.path.PathManager
+import com.movtery.zalithlauncher.setting.AllSettings
+import java.io.File
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import kotlin.math.abs
+
+/**
+ * Pocket Client: records battery use while the game runs, into logs/battery_<time>.csv.
+ * The logs folder is what "share logs" zips, so the file reaches us with the other logs.
+ *
+ * Every 30 s: battery %, current, voltage, power, temperature, thermal status, FPS (average and lowest second
+ * of those 30 s) and the game process' memory (RSS). At the end a summary line: minutes played, % used, % per
+ * minute, average power, average FPS and peak memory. The Java heap itself is in gc_<time>.log (same folder).
+ */
+object PocketBatteryLog {
+    private const val TAG = "PocketBatteryLog"
+    private const val INTERVAL_MS = 30_000L
+    private const val FPS_INTERVAL_MS = 1_000L
+
+    /** Time stamp of the running session's files, shared with the GC log (PocketTuning.addGcLog). */
+    @Volatile
+    var stamp: String? = null
+        private set
+
+    private var thread: HandlerThread? = null
+    private var handler: Handler? = null
+    private var file: File? = null
+    private var startTime = 0L
+    private var startPercent = -1
+    private var lastPercent = -1
+    private var powerSumMw = 0.0
+    private var samples = 0
+    private var fpsSum = 0L
+    private var fpsCount = 0
+    private var fpsMin = Int.MAX_VALUE
+    private var totalFpsSum = 0L
+    private var totalFpsCount = 0
+    private var peakRssMb = 0L
+
+    fun start(context: Context, title: String) {
+        if (thread != null) return
+        val app = context.applicationContext
+        try {
+            val dir = runCatching { PathManager.DIR_LAUNCHER_LOGS }.getOrNull()
+                ?: File(app.getExternalFilesDir(null), "logs")
+            dir.mkdirs()
+            val stamp = SimpleDateFormat("yyyy-MM-dd_HH-mm-ss", Locale.ROOT).format(Date())
+            this.stamp = stamp
+            val out = File(dir, "battery_$stamp.csv")
+            out.writeText(
+                "# Pocket Client battery log\n" +
+                    "# launcher=${BuildConfig.VERSION_NAME} device=${Build.MANUFACTURER} ${Build.MODEL} android=${Build.VERSION.SDK_INT}\n" +
+                    "# game=$title\n" +
+                    "# settings: resolution=${AllSettings.resolutionRatio.getValue()}% surfaceView=${AllSettings.pcUseSurfaceView.getValue()} " +
+                    "java25=${AllSettings.pcJava25CompactHeaders.getValue()} maxRefresh=${AllSettings.requestMaxRefreshRate.getValue()} " +
+                    "sustained=${AllSettings.sustainedPerformance.getValue()}\n" +
+                    "minute,battery_pct,current_ma,voltage_v,power_w,temp_c,thermal,charging,fps_avg,fps_min,rss_mb\n"
+            )
+            file = out
+            startTime = System.currentTimeMillis()
+            startPercent = -1
+            lastPercent = -1
+            powerSumMw = 0.0
+            samples = 0
+            fpsSum = 0
+            fpsCount = 0
+            fpsMin = Int.MAX_VALUE
+            totalFpsSum = 0
+            totalFpsCount = 0
+            peakRssMb = 0
+
+            val t = HandlerThread("PocketBatteryLog").also { it.start() }
+            thread = t
+            val h = Handler(t.looper)
+            handler = h
+            h.post(object : Runnable {
+                override fun run() {
+                    sample(app)
+                    handler?.postDelayed(this, INTERVAL_MS)
+                }
+            })
+            //FPS is a per-second counter in the native bridge; read it every second and average per row
+            h.postDelayed(object : Runnable {
+                override fun run() {
+                    sampleFps()
+                    handler?.postDelayed(this, FPS_INTERVAL_MS)
+                }
+            }, FPS_INTERVAL_MS)
+        } catch (e: Exception) {
+            Log.w(TAG, "Could not start the battery log", e)
+        }
+    }
+
+    /** Writes the summary right away (the game process may end soon after). */
+    fun stop() {
+        val h = handler ?: return
+        handler = null
+        h.removeCallbacksAndMessages(null)
+        writeSummary()
+        thread?.quitSafely()
+        thread = null
+        file = null
+        stamp = null
+    }
+
+    private fun sampleFps() {
+        val fps = try {
+            org.lwjgl.glfw.CallbackBridge.getCurrentFps()
+        } catch (e: Throwable) { //native library not loaded yet
+            return
+        }
+        //0 while the game is still loading (nothing drawn yet): not a frame rate
+        if (fps <= 0) return
+        fpsSum += fps
+        fpsCount++
+        if (fps < fpsMin) fpsMin = fps
+        totalFpsSum += fps
+        totalFpsCount++
+    }
+
+    /** Memory of the whole game process (Java heap, native, graphics buffers): what Android looks at before killing it. */
+    private fun rssMb(): Long = try {
+        File("/proc/self/status").useLines { lines ->
+            lines.firstOrNull { it.startsWith("VmRSS:") }
+                ?.split(Regex("\\s+"))?.getOrNull(1)?.toLongOrNull()?.div(1024) ?: -1L
+        }
+    } catch (e: Exception) {
+        -1L
+    }
+
+    private fun sample(context: Context) {
+        val out = file ?: return
+        try {
+            val bm = context.getSystemService(Context.BATTERY_SERVICE) as BatteryManager
+            val percent = bm.getIntProperty(BatteryManager.BATTERY_PROPERTY_CAPACITY)
+            val currentUa = bm.getIntProperty(BatteryManager.BATTERY_PROPERTY_CURRENT_NOW)
+            //Most phones report microamps; a few report milliamps. Values under 20000 are taken as mA.
+            val currentMa = if (abs(currentUa) < 20_000) abs(currentUa).toDouble() else abs(currentUa) / 1000.0
+
+            val status: Intent? = context.registerReceiver(null, IntentFilter(Intent.ACTION_BATTERY_CHANGED))
+            val voltage = (status?.getIntExtra(BatteryManager.EXTRA_VOLTAGE, 0) ?: 0) / 1000.0
+            val temp = (status?.getIntExtra(BatteryManager.EXTRA_TEMPERATURE, 0) ?: 0) / 10.0
+            val plugged = (status?.getIntExtra(BatteryManager.EXTRA_PLUGGED, 0) ?: 0) != 0
+            val powerW = currentMa * voltage / 1000.0
+
+            val thermal = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+                (context.getSystemService(Context.POWER_SERVICE) as PowerManager).currentThermalStatus
+            } else -1
+
+            val fpsAvg = if (fpsCount > 0) fpsSum.toDouble() / fpsCount else 0.0
+            val fpsLow = if (fpsCount > 0) fpsMin else 0
+            fpsSum = 0
+            fpsCount = 0
+            fpsMin = Int.MAX_VALUE
+            val rss = rssMb()
+            if (rss > peakRssMb) peakRssMb = rss
+            val minute = (System.currentTimeMillis() - startTime) / 60000.0
+
+            if (startPercent < 0) startPercent = percent
+            lastPercent = percent
+            if (!plugged) {
+                powerSumMw += powerW * 1000
+                samples++
+            }
+
+            out.appendText(
+                String.format(
+                    Locale.ROOT, "%.1f,%d,%.0f,%.2f,%.2f,%.1f,%d,%b,%.1f,%d,%d\n",
+                    minute, percent, currentMa, voltage, powerW, temp, thermal, plugged, fpsAvg, fpsLow, rss
+                )
+            )
+        } catch (e: Exception) {
+            Log.w(TAG, "Battery sample failed", e)
+        }
+    }
+
+    private fun writeSummary() {
+        val out = file ?: return
+        try {
+            val minutes = (System.currentTimeMillis() - startTime) / 60000.0
+            val used = if (startPercent >= 0 && lastPercent >= 0) startPercent - lastPercent else 0
+            val perMinute = if (minutes > 0) used / minutes else 0.0
+            val avgW = if (samples > 0) powerSumMw / samples / 1000 else 0.0
+            val avgFps = if (totalFpsCount > 0) totalFpsSum.toDouble() / totalFpsCount else 0.0
+            out.appendText(
+                String.format(
+                    Locale.ROOT,
+                    "# summary: %.1f min, %d%% used (%d%% -> %d%%), %.2f %%/min, average %.2f W while unplugged, " +
+                        "average %.1f FPS, peak memory %d MB\n",
+                    minutes, used, startPercent, lastPercent, perMinute, avgW, avgFps, peakRssMb
+                )
+            )
+        } catch (e: Exception) {
+            Log.w(TAG, "Could not write the battery summary", e)
+        }
+    }
+}
diff --git a/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/pocket/PocketLogin.kt b/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/pocket/PocketLogin.kt
