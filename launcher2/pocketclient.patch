@@ -0,0 +1,112 @@
+package com.movtery.zalithlauncher.pocket
+
+import android.annotation.SuppressLint
+import android.app.Activity
+import android.content.Context
+import android.content.Intent
+import android.graphics.Bitmap
+import android.graphics.Color
+import android.net.Uri
+import android.os.Bundle
+import android.webkit.CookieManager
+import android.webkit.WebResourceRequest
+import android.webkit.WebView
+import android.webkit.WebViewClient
+import kotlinx.coroutines.CompletableDeferred
+import kotlin.coroutines.cancellation.CancellationException
+
+/**
+ * Pocket Client: Microsoft sign-in the same way Pocket Client 1 did it, which worked for this account:
+ * login.live.com authorization-code flow with the public Minecraft launcher client ID, shown in a plain
+ * WebView. The device-code flow kept ending in "invalid_grant" for some accounts.
+ */
+object PocketLogin {
+    const val CLIENT_ID = "00000000402b5328"
+    const val SCOPE = "service::user.auth.xboxlive.com::MBI_SSL"
+    const val REDIRECT_URL = "https://login.live.com/oauth20_desktop.srf"
+    const val AUTHORIZE_URL = "https://login.live.com/oauth20_authorize.srf" +
+            "?client_id=$CLIENT_ID" +
+            "&response_type=code" +
+            "&scope=service%3A%3Auser.auth.xboxlive.com%3A%3AMBI_SSL" +
+            "&redirect_url=https%3A%2F%2Flogin.live.com%2Foauth20_desktop.srf"
+
+    /** Where login.live.com sends the browser after sign-in, carrying ?code=... */
+    const val RESULT_PREFIX = "ms-xal-$CLIENT_ID"
+
+    @Volatile
+    private var pending: CompletableDeferred<String?>? = null
+
+    /** Opens the sign-in page and waits for the authorization code. Throws CancellationException if the user backs out. */
+    suspend fun requestCode(context: Context): String {
+        val deferred = CompletableDeferred<String?>()
+        pending?.complete(null)
+        pending = deferred
+        context.startActivity(
+            Intent(context, PocketLoginActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        )
+        return deferred.await() ?: throw CancellationException("Microsoft sign-in was cancelled")
+    }
+
+    internal fun deliver(code: String?) {
+        pending?.complete(code)
+        pending = null
+    }
+}
+
+class PocketLoginActivity : Activity() {
+    private var delivered = false
+
+    @SuppressLint("SetJavaScriptEnabled")
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val web = WebView(this)
+        web.setBackgroundColor(Color.WHITE)
+        setContentView(web)
+
+        web.settings.javaScriptEnabled = true
+        web.settings.domStorageEnabled = true
+        web.webViewClient = object : WebViewClient() {
+            override fun shouldOverrideUrlLoading(view: WebView, request: WebResourceRequest): Boolean =
+                handle(request.url.toString())
+
+            override fun onPageStarted(view: WebView, url: String, favicon: Bitmap?) {
+                if (!handle(url)) super.onPageStarted(view, url, favicon)
+            }
+        }
+
+        //A fresh session every time, like Pocket Client 1
+        CookieManager.getInstance().removeAllCookies {
+            web.clearHistory()
+            web.clearCache(true)
+            web.clearFormData()
+            web.loadUrl(PocketLogin.AUTHORIZE_URL)
+        }
+    }
+
+    private fun handle(url: String): Boolean {
+        if (url.startsWith(PocketLogin.RESULT_PREFIX)) {
+            finishWith(Uri.parse(url).getQueryParameter("code"))
+            return true
+        }
+        if (url.contains("res=cancel")) {
+            finishWith(null)
+            return true
+        }
+        return false
+    }
+
+    private fun finishWith(code: String?) {
+        if (delivered) return
+        delivered = true
+        PocketLogin.deliver(code)
+        finish()
+    }
+
+    override fun onDestroy() {
+        if (!delivered) {
+            delivered = true
+            PocketLogin.deliver(null)
+        }
+        super.onDestroy()
+    }
+}
diff --git a/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/pocket/PocketTuning.kt b/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/pocket/PocketTuning.kt
new file mode 100644
index 0000000..809a00d
--- /dev/null
+++ b/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/pocket/PocketTuning.kt
@@ -0,0 +1,203 @@
+package com.movtery.zalithlauncher.pocket
+
+import android.app.ActivityManager
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import android.os.Process
+import android.util.Log
+import java.io.File
+
+/**
+ * Pocket Client: battery and smoothness defaults for phones.
+ */
+object PocketTuning {
+    private const val TAG = "PocketTuning"
+    private const val MARKER = ".pocketclient-tuned"
+
+    fun totalRamMb(context: Context): Long {
+        val am = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
+        val info = ActivityManager.MemoryInfo()
+        am.getMemoryInfo(info)
+        return info.totalMem / (1024 * 1024)
+    }
+
+    /** Java heap when the player never set one. Upstream would fall back to the 256 MB minimum. */
+    fun defaultRamMb(context: Context): Int {
+        val total = totalRamMb(context)
+        return when {
+            total >= 7168 -> 3072
+            total >= 5120 -> 2048
+            total >= 3584 -> 1536
+            else -> 1024
+        }
+    }
+
+    /** The heap the game really gets: [defaultRamMb] when the player never set one (see Launcher.progressFinalUserArgs). */
+    fun effectiveHeapMb(ramAllocation: Int): Int =
+        if (com.movtery.zalithlauncher.setting.AllSettings.ramAllocation.getValue() == null && ramAllocation <= 256) {
+            defaultRamMb(com.movtery.zalithlauncher.context.GlobalContext)
+        } else ramAllocation
+
+    /**
+     * G1 tuned for short pauses: most stutter (and wasted CPU, i.e. battery) in modded play comes from long
+     * collections. Skipped when the player set their own GC flags.
+     */
+    fun addGcArgs(args: MutableList<String>, heapMb: Int) {
+        addThreadBudget(args)
+        if (args.any { (it.startsWith("-XX:+Use") && it.endsWith("GC")) || it.startsWith("-XX:MaxGCPauseMillis") || it.startsWith("-XX:G1") }) return
+        val small = heapMb <= LOW_MEMORY_HEAP_MB
+        args.add("-XX:+UseG1GC")
+        args.add("-XX:+UnlockExperimentalVMOptions")
+        args.add("-XX:MaxGCPauseMillis=40")
+        args.add("-XX:G1NewSizePercent=20")
+        //The reserve is heap G1 keeps empty for emergencies: 20% of 512 MB would be 100 MB the game can't use
+        args.add("-XX:G1ReservePercent=${if (small) 10 else 20}")
+        args.add("-XX:+ParallelRefProcEnabled")
+        args.add("-XX:+DisableExplicitGC")
+        if (small) {
+            //Mods and resource packs hold many copies of the same strings; G1 merges them in the background
+            args.add("-XX:+UseStringDeduplication")
+            //Give cached (softly referenced) data back as soon as the heap gets tight, instead of running out
+            args.add("-XX:SoftRefLRUPolicyMSPerMB=0")
+        }
+    }
+
+    /** Heap at or below this gets the low-memory treatment (GC flags above, capped options in [tuneOptions]). */
+    const val LOW_MEMORY_HEAP_MB = 1024
+
+    /**
+     * GC log for this session next to the battery log (logs/gc_<time>.log). One line per collection, so it is
+     * nearly free, and it shows how full the Java heap really gets: what we need to tune for small heaps.
+     * Java 9+ only (the -Xlog syntax).
+     */
+    fun addGcLog(args: MutableList<String>, javaVersion: Int) {
+        if (javaVersion < 9 || args.any { it.startsWith("-Xlog:gc") || it.startsWith("-Xloggc") }) return
+        val stamp = PocketBatteryLog.stamp ?: return
+        val dir = runCatching { com.movtery.zalithlauncher.path.PathManager.DIR_LAUNCHER_LOGS }.getOrNull() ?: return
+        //No ':' in Android app paths, which -Xlog uses as its separator
+        args.add("-Xlog:gc:file=${File(dir, "gc_$stamp.log").absolutePath}:uptime:filecount=0")
+    }
+
+    /**
+     * A desktop JVM and Minecraft size their thread pools to "all cores": world/chunk workers, GC workers and
+     * JIT compilers all wake up together and keep every big core at high clocks. On a phone that is heat and
+     * battery for little gain. Cap the background pools so the render thread keeps a core to itself and the
+     * rest can idle. Each flag is skipped if the player set it.
+     */
+    private fun addThreadBudget(args: MutableList<String>) {
+        val cores = Runtime.getRuntime().availableProcessors()
+        fun addIfMissing(prefix: String, arg: String) {
+            if (args.none { it.startsWith(prefix) }) args.add(arg)
+        }
+        addIfMissing("-Dmax.bg.threads", "-Dmax.bg.threads=${maxOf(2, cores / 2 - 1)}") //Minecraft worker pool
+        addIfMissing("-XX:ParallelGCThreads", "-XX:ParallelGCThreads=${maxOf(2, cores / 3)}")
+        addIfMissing("-XX:ConcGCThreads", "-XX:ConcGCThreads=1")
+        addIfMissing("-XX:CICompilerCount", "-XX:CICompilerCount=${if (cores >= 8) 3 else 2}")
+    }
+
+    /**
+     * Once per game directory: distances, FPS cap and cheap visual options that fit the phone.
+     * 60 FPS instead of uncapped roughly halves GPU work. Anything the player changes later is kept.
+     */
+    fun tuneOptions(context: Context, gameDir: File, heapMb: Int) {
+        try {
+            val marker = File(gameDir, MARKER)
+            if (marker.exists()) {
+                capForSmallHeap(gameDir, heapMb)
+                return
+            }
+            val ram = totalRamMb(context)
+            val tier = when {
+                ram < 4096 -> listOf("renderDistance" to "4", "simulationDistance" to "4", "maxFps" to "40", "particles" to "2")
+                ram < 8192 -> listOf("renderDistance" to "6", "simulationDistance" to "5", "maxFps" to "60", "particles" to "1")
+                else -> listOf("renderDistance" to "8", "simulationDistance" to "6", "maxFps" to "60", "particles" to "1")
+            }
+            val cheap = listOf(
+                "enableVsync" to "false",
+                "graphicsMode" to "0",
+                "renderClouds" to "\"false\"",
+                "entityShadows" to "false",
+                "biomeBlendRadius" to "0",
+                "mipmapLevels" to "0",
+                "entityDistanceScaling" to "0.75"
+            )
+
+            val file = File(gameDir, "options.txt")
+            val options = readOptions(file)
+            (tier + cheap).forEach { (k, v) -> options[k] = v }
+            writeOptions(file, options)
+            marker.createNewFile()
+            Log.i(TAG, "Tuned options for $ram MB RAM: $tier")
+            //The once-only defaults above may be higher than a small heap can hold
+            capForSmallHeap(gameDir, heapMb)
+        } catch (e: Exception) {
+            Log.w(TAG, "Could not tune options", e)
+        }
+    }
+
+    /**
+     * Every launch, when the Java heap is small (around 512 MB): lower the options that fill the heap, so the game
+     * doesn't run out of memory and crash. Loaded chunks grow with the square of the render distance, so it is
+     * the big one. Only lowers values; a bigger heap leaves the player's settings alone.
+     */
+    private fun capForSmallHeap(gameDir: File, heapMb: Int) {
+        if (heapMb > LOW_MEMORY_HEAP_MB) return
+        val file = File(gameDir, "options.txt")
+        val options = readOptions(file)
+        val maxDistance = when {
+            heapMb <= 640 -> 3
+            heapMb <= 768 -> 4
+            else -> 6
+        }
+        var changed = false
+        fun capInt(key: String, max: Int) {
+            val now = options[key]?.trim()?.toIntOrNull()
+            if (now == null || now > max) {
+                options[key] = max.toString()
+                changed = true
+            }
+        }
+        capInt("renderDistance", maxDistance)
+        capInt("simulationDistance", 5) //5 is the lowest the game allows
+        capInt("mipmapLevels", 0)
+        capInt("biomeBlendRadius", 0)
+        val scaling = options["entityDistanceScaling"]?.trim()?.toDoubleOrNull()
+        if (scaling == null || scaling > 0.5) {
+            options["entityDistanceScaling"] = "0.5"
+            changed = true
+        }
+        if (changed) {
+            writeOptions(file, options)
+            Log.i(TAG, "Capped options for a $heapMb MB heap: render distance $maxDistance")
+        }
+    }
+
+    private fun readOptions(file: File): LinkedHashMap<String, String> {
+        val options = LinkedHashMap<String, String>()
+        if (file.isFile) {
+            file.readLines().forEach { line ->
+                val i = line.indexOf(':')
+                if (i > 0) options[line.substring(0, i)] = line.substring(i + 1)
+            }
+        }
+        return options
+    }
+
+    private fun writeOptions(file: File, options: Map<String, String>) {
+        file.parentFile?.mkdirs()
+        file.writeText(options.entries.joinToString("\n") { "${it.key}:${it.value}" } + "\n")
+    }
+
+    /**
+     * The game runs in its own process (":game"). Once it has started, the launcher's process is not needed:
+     * end it so none of its threads, services or UI keep using CPU and memory while playing.
+     * When the game exits, the launcher is restarted (upstream already does this).
+     */
+    fun endLauncherProcessSoon() {
+        Handler(Looper.getMainLooper()).postDelayed({
+            Log.i(TAG, "Game started, ending the launcher process")
+            Process.killProcess(Process.myPid())
+        }, 3000)
+    }
+}
diff --git a/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/pocket/PocketUpdater.kt b/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/pocket/PocketUpdater.kt
