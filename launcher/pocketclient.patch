+    /**
+     * Pocket Client: once per game directory, picks distances and an FPS cap that fit the phone.
+     * 60 FPS instead of 120 roughly halves GPU work and battery drain; weak phones get shorter distances.
+     * Runs only once, so anything the player changes afterwards is kept.
+     */
+    private fun tuneForDevice(context: Context) {
+        try {
+            val optionsFile = getOptionsFile()
+            val marker = File(optionsFile.parentFile, ".pocketclient-tuned")
+            if (marker.exists() || !optionsFile.exists()) return
+
+            val ram = Tools.getTotalDeviceMemory(context)
+            val values = when {
+                ram < 4096 -> listOf("renderDistance" to "4", "simulationDistance" to "4", "maxFps" to "40", "particles" to "2")
+                ram < 8192 -> listOf("renderDistance" to "6", "simulationDistance" to "5", "maxFps" to "60", "particles" to "1")
+                else -> listOf("renderDistance" to "8", "simulationDistance" to "6", "maxFps" to "60", "particles" to "1")
+            }
+            values.forEach { (key, value) -> set(key, value) }
+            save()
+            marker.createNewFile()
+            Logging.i("MCOptions", "Tuned options for a device with $ram MB RAM: $values")
+        } catch (e: Exception) {
+            Logging.e("MCOptions", "Could not tune options: " + Tools.printToString(e))
+        }
     }
 
