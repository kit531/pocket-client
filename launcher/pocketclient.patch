+    /**
+     * Pocket Client: G1 tuned for short pauses. Most stutter in heavy modpacks on phones comes from
+     * long garbage-collection pauses, not from rendering. Skipped when the user set their own GC flags.
+     */
+    private static void addPocketGcArgs(List<String> userArgs) {
+        for (String arg : userArgs) {
+            if (arg.startsWith("-XX:+Use") && arg.endsWith("GC")) return;
+            if (arg.startsWith("-XX:MaxGCPauseMillis") || arg.startsWith("-XX:G1")) return;
+        }
+        userArgs.add("-XX:+UseG1GC");
+        userArgs.add("-XX:+UnlockExperimentalVMOptions");
+        userArgs.add("-XX:MaxGCPauseMillis=40");
+        userArgs.add("-XX:G1NewSizePercent=20");
+        userArgs.add("-XX:G1ReservePercent=20");
+        userArgs.add("-XX:+ParallelRefProcEnabled");
+        userArgs.add("-XX:+DisableExplicitGC");
+    }
