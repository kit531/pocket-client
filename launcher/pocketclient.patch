+    private fun setupAutoFix() {
+        val plan = ModAutoFix.analyze(File(PathManager.DIR_GAME_HOME, "latestlog.txt")) ?: return
+
+        val summary = StringBuilder(getString(R.string.pc_auto_fix_found))
+        plan.fixes.forEach { summary.append("\n• ").append(it.describe()) }
+        if (plan.skipped.isNotEmpty()) {
+            summary.append("\n\n").append(getString(R.string.pc_auto_fix_skipped))
+            plan.skipped.forEach { summary.append("\n• ").append(it) }
+        }
+        binding.errorText.append("\n\n" + summary)
+
+        binding.errorAutoFix.visibility = View.VISIBLE
+        binding.errorAutoFix.setOnClickListener {
+            binding.errorAutoFix.isEnabled = false
+            binding.errorText.append("\n\n" + getString(R.string.pc_auto_fix_working))
+            Thread {
+                val results = ModAutoFix.applyFixes(plan)
+                runOnUiThread {
+                    binding.errorText.append("\n" + results.joinToString("\n") + "\n\n" + getString(R.string.pc_auto_fix_done))
+                    binding.errorAutoFix.isEnabled = true
+                }
+            }.start()
+        }
     }
 
