diff --git a/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/feature/BuiltinMods.kt b/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/feature/BuiltinMods.kt
new file mode 100644
index 0000000..4ce19bc
--- /dev/null
+++ b/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/feature/BuiltinMods.kt
@@ -0,0 +1,67 @@
+package com.movtery.zalithlauncher.feature
+
+import android.content.Context
+import com.movtery.zalithlauncher.feature.log.Logging
+import com.movtery.zalithlauncher.feature.version.Version
+import net.kdt.pojavlaunch.Tools
+import java.io.File
+
+/**
+ * Pocket Client: installs the mods bundled in assets/builtin_mods into a version's mods folder.
+ *
+ * Asset names look like `<keyword>__<real-file-name>.jar`:
+ *  - `pocketclient__...` is the client mod itself. It is refreshed on every launch,
+ *    so a launcher update also updates the mod.
+ *  - Any other keyword (fabric-api, ferritecore, ...) is installed only the first time a version
+ *    is launched, and only if no jar with that keyword in its name exists yet. Delete them
+ *    from the mods folder and they stay deleted.
+ *
+ * Installs only into version-isolated Fabric versions of [TARGET_MC_VERSION], because the
+ * bundled jars were built for exactly that Minecraft version. If the assets folder is empty
+ * (a build without the bundle), this does nothing.
+ */
+object BuiltinMods {
+    private const val TAG = "BuiltinMods"
+    private const val ASSET_DIR = "builtin_mods"
+    private const val OWN_KEYWORD = "pocketclient"
+    private const val TARGET_MC_VERSION = "1.21.1"
+    private const val MARKER_NAME = ".pocketclient-builtin"
+
+    @JvmStatic
+    fun install(context: Context, version: Version) {
+        runCatching {
+            if (!version.isIsolation()) return
+            val info = version.getVersionInfo() ?: return
+            if (info.minecraftVersion != TARGET_MC_VERSION) return
+            if (info.loaderInfo?.any { it.name == "Fabric" } != true) return
+
+            val assets = context.assets.list(ASSET_DIR)?.filter { it.endsWith(".jar") && it.contains("__") }
+            if (assets.isNullOrEmpty()) return
+
+            val modsDir = File(version.getGameDir(), "mods").apply { mkdirs() }
+            val marker = File(modsDir, MARKER_NAME)
+            val firstRun = !marker.exists()
+            val existing = modsDir.listFiles { f -> f.isFile && f.name.endsWith(".jar") }
+                ?.map { it.name.lowercase() }
+                .orEmpty()
+
+            for (asset in assets) {
+                val keyword = asset.substringBefore("__").lowercase()
+                val fileName = asset.substringAfter("__")
+
+                if (keyword == OWN_KEYWORD) {
+                    modsDir.listFiles { f -> f.isFile && f.name.lowercase().startsWith(OWN_KEYWORD) && f.name != fileName }
+                        ?.forEach { it.delete() }
+                    Tools.copyAssetFile(context, "$ASSET_DIR/$asset", modsDir.absolutePath, fileName, true)
+                } else if (firstRun && existing.none { it.contains(keyword) }) {
+                    Tools.copyAssetFile(context, "$ASSET_DIR/$asset", modsDir.absolutePath, fileName, false)
+                }
+            }
+
+            if (firstRun) marker.createNewFile()
+            Logging.i(TAG, "Built-in mods installed into ${modsDir.absolutePath}")
+        }.onFailure { e ->
+            Logging.e(TAG, "Failed to install built-in mods: ${Tools.printToString(e)}")
+        }
+    }
+}
