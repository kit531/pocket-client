+package com.movtery.zalithlauncher.feature
+
+import android.app.Activity
+import android.content.pm.ActivityInfo
+import com.movtery.zalithlauncher.setting.AllSettings
+
+/**
+ * Pocket Client: lets the launcher screens (not the game) run in portrait or rotate freely.
+ */
+object LauncherOrientation {
+    @JvmStatic
+    fun apply(activity: Activity) {
+        activity.requestedOrientation = when (AllSettings.launcherOrientation.getValue()) {
+            "portrait" -> ActivityInfo.SCREEN_ORIENTATION_SENSOR_PORTRAIT
+            "auto" -> ActivityInfo.SCREEN_ORIENTATION_FULL_SENSOR
+            else -> ActivityInfo.SCREEN_ORIENTATION_SENSOR_LANDSCAPE
+        }
+    }
+}
